<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BarClip.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:BarClip.Maui"
    xmlns:views="clr-namespace:BarClip.Maui.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="BarClip">

    <TabBar>
        <Tab Title="Home" Icon="media_library.png">
            <ShellContent ContentTemplate="{DataTemplate views:HomePage}"/>
        </Tab>
        <Tab Title="Create" Icon="create_session.png">
            <ShellContent ContentTemplate="{DataTemplate views:SessionLibraryPage}"/>
        </Tab>
        <Tab Title="Sessions" Icon="session_library.png">
            <ShellContent ContentTemplate="{DataTemplate views:VideoLibraryPage}"/>
        </Tab>
    </TabBar>

</Shell>