<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BarClip.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:BarClip.Maui"
    Shell.FlyoutBehavior="Disabled"
    Title="BarClip">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />
    <ShellContent
        Title="SessionLibraryPage"
        ContentTemplate="{DataTemplate local:SessionLibraryPage}"
        Route="SessionLibraryPage"        />
    <ShellContent
        Title="VideoLibraryPage"
        ContentTemplate="{DataTemplate local:VideoLibraryPage}"
        Route="VideoLibraryPage"        />
    <ShellContent
        Title="VideoPlayerPage"
        ContentTemplate="{DataTemplate local:VideoPlayerPage}"
        Route="VideoPlayerPage"        />
    <ShellContent
        Title="CameraPage"
        ContentTemplate="{DataTemplate local:CameraPage}"
        Route="CameraPage"        />
    

</Shell>