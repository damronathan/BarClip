<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BarClip.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:BarClip.Maui"
    Shell.FlyoutBehavior="Disabled"
    Title="BarClip">

    <!-- Home: no back button here, so the wordmark gets the full bar to itself -->
    <ShellContent
        Title=""
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage">
        <Shell.TitleView>
            <Label Style="{StaticResource Wordmark}"
                   VerticalOptions="Center"
                   SemanticProperties.Description="BarClip logo">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Bar" Style="{StaticResource WordmarkBarSpan}" />
                        <Span Text="Clip" Style="{StaticResource WordmarkClipSpan}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
        </Shell.TitleView>
    </ShellContent>

    <!-- Inner pages keep the native back button + a plain functional title, no wordmark -->
    <ShellContent
        Title="Sessions"
        ContentTemplate="{DataTemplate local:SessionLibraryPage}"
        Route="SessionLibraryPage" />
    <!--<ShellContent
        Title="VideoLibraryPage"
        ContentTemplate="{DataTemplate local:VideoLibraryPage}"
        Route="VideoLibraryPage"        />-->
    <ShellContent
        Title="Session"
        ContentTemplate="{DataTemplate local:VideoPlayerPage}"
        Route="VideoPlayerPage" />
    <!--<ShellContent
        Title="CameraPage"
        ContentTemplate="{DataTemplate local:CameraPage}"
        Route="CameraPage"        />-->


</Shell>
