<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BarClip.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:BarClip.Maui"
    xmlns:views="clr-namespace:BarClip.Maui.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="BarClip">

    <TabBar>
        <Tab Title="Library" Icon="medialibrary.png">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}"/>
        </Tab>
        <Tab Title="Create" Icon="createsession.png">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}"/>
        </Tab>
        <Tab Title="Sessions" Icon="sessionlibrary.png">
            <ShellContent ContentTemplate="{DataTemplate local:SessionLibrary}"/>
        </Tab>
    </TabBar>

</Shell>