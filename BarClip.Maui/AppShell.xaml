<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BarClip.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:BarClip.Maui"
    Shell.FlyoutBehavior="Disabled"
    Title="BarClip.Maui">

    <Shell.ToolbarItems>
        <ToolbarItem
            x:Name="AuthToolbarItem"
            Text="Sign In"
            Clicked="OnAuthButtonClicked" />
    </Shell.ToolbarItems>

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />
    <ShellContent
        Title="SessionLibrary"
        ContentTemplate="{DataTemplate local:SessionLibrary}"
        Route="SessionLibrary" />
</Shell>