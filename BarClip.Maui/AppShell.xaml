<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BarClip.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:BarClip.Maui"
    xmlns:views="clr-namespace:BarClip.Maui.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="BarClip">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />
    <ShellContent
        Title="SessionLibrary"
        ContentTemplate="{DataTemplate local:SessionLibrary}"
        Route="SessionLibrary"        />
    <ShellContent
        Title="VideoLibrary"
        ContentTemplate="{DataTemplate local:VideoLibrary}"
        Route="VideoLibrary"        />
    <ShellContent
        Title="VideoPlayerView"
        ContentTemplate="{DataTemplate local:VideoPlayerView}"
        Route="VideoPlayerView"        />
    <ShellContent
        Title="CameraView"
        ContentTemplate="{DataTemplate local:CameraView}"
        Route="CameraView"        />
    

</Shell>