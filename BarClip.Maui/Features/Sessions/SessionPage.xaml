<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             xmlns:converters="clr-namespace:BarClip.Maui.Converters;assembly=BarClip.Maui"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             x:Class="BarClip.Maui.SessionPage"
             Title="Session">
    <ContentPage.ToolbarItems>
        <ToolbarItem
            Text="Delete"
            Command="{Binding DeleteSessionCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*, Auto">

        <CollectionView Grid.Row="0"
                        ItemsSource="{Binding LiftVideos}"
                        SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="5,5,5,0"
                            Padding="10"
                            StrokeShape="RoundRectangle 8"
                            Stroke="White"
                            BackgroundColor="Transparent">

                        <Grid ColumnDefinitions="200,*"
                              RowDefinitions="Auto">

                            <!-- Thumbnail -->
                            <Image Grid.Column="0"
                                   Source="{Binding ThumbnailPath}"
                                   Aspect="AspectFit"
                                   HeightRequest="200"
                                   WidthRequest="200" />

                            <!-- Play icon centered over the thumbnail (scrim + shadow) -->
                            <Border Grid.Column="0"
                                    IsVisible="{Binding IsProcessed}"
                                    BackgroundColor="#80000000"
                                    Stroke="Transparent"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 32"
                                    Padding="0"
                                    HeightRequest="64"
                                    WidthRequest="64"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Opacity="0.6" Radius="8" Offset="0,2" />
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ProcessCommand}" />
                                </Border.GestureRecognizers>
                                <Border.Behaviors>
                                    <toolkit:TouchBehavior PressedScale="0.85"
                                                           DefaultAnimationDuration="80" />
                                </Border.Behaviors>
                                <Image Style="{StaticResource ActionCardIconSmall}" Source="playcircle" />
                            </Border>

                            <!-- Trim: same slot as Save, shown only before processing -->
                            <Border Grid.Column="1"
                                    Style="{StaticResource ActionCardSmall}"
                                    IsVisible="{Binding IsProcessed, Converter={StaticResource InvertedBoolConverter}}"
                                    SemanticProperties.Description="Trim"
                                    SemanticProperties.Hint="Trims this video">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ProcessCommand}" />
                                </Border.GestureRecognizers>
                                <Border.Behaviors>
                                    <toolkit:TouchBehavior PressedScale="0.85"
                                                           DefaultAnimationDuration="80" />
                                </Border.Behaviors>
                                <Image Style="{StaticResource ActionCardIconSmall}" Source="trim" />
                            </Border>

                            <!-- Save: same slot as Trim, shown only after processing -->
                            <Border Grid.Column="1"
                                    Style="{StaticResource ActionCardSmall}"
                                    IsVisible="{Binding IsProcessed}"
                                    SemanticProperties.Description="Save"
                                    SemanticProperties.Hint="Saves this video to your library">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SaveCommand}" />
                                </Border.GestureRecognizers>
                                <Border.Behaviors>
                                    <toolkit:TouchBehavior PressedScale="0.85"
                                                           DefaultAnimationDuration="80" />
                                </Border.Behaviors>
                                <Image Style="{StaticResource ActionCardIconSmall}" Source="download" />
                            </Border>

                        </Grid>

                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <VerticalStackLayout Spacing="10"
                                     Padding="10,10,10,20">

                    <!--<Button Text="Upload Session"
                            IsVisible="{Binding HasVideos}"
                            Command="{Binding UploadSessionCommand}"
                            BackgroundColor="{DynamicResource Primary}"
                            TextColor="White"
                            FontAttributes="Bold"
                            HeightRequest="55"
                            CornerRadius="12"
                            HorizontalOptions="Fill" />-->

                </VerticalStackLayout>
            </CollectionView.Footer>

        </CollectionView>

        <!-- Bottom Tab Bar -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto,*"
              BackgroundColor="Black"
              Padding="10,12,10,12"
              IgnoreSafeArea="True">

            <!-- Left slot: Merge -> Play -->
            <Grid Grid.Column="0" HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,16,0">

                <Border Style="{StaticResource ActionCardTab}"
                        IsVisible="{Binding CanCreateFullVideo}"
                        SemanticProperties.Description="Create Full Video"
                        SemanticProperties.Hint="Merges the session's videos into one">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ProcessSessionCommand}" />
                    </Border.GestureRecognizers>
                    <Border.Behaviors>
                        <toolkit:TouchBehavior PressedScale="0.85"
                                               DefaultAnimationDuration="80" />
                    </Border.Behaviors>
                    <Image Style="{StaticResource ActionCardIconSmall}" Source="merge" />
                </Border>

                <Border Style="{StaticResource ActionCardTab}"
                        IsVisible="{Binding IsSessionProcessed}"
                        SemanticProperties.Description="Play Full Video"
                        SemanticProperties.Hint="Plays the merged session video">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ProcessSessionCommand}" />
                    </Border.GestureRecognizers>
                    <Border.Behaviors>
                        <toolkit:TouchBehavior PressedScale="0.85"
                                               DefaultAnimationDuration="80" />
                    </Border.Behaviors>
                    <Image Style="{StaticResource ActionCardIconSmall}" Source="playcircle" />
                </Border>

            </Grid>

            <!-- Center: Add -->
            <Border Grid.Column="1"
                    Style="{StaticResource ActionCardTab}"
                    WidthRequest="76"
                    HeightRequest="76"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    SemanticProperties.Description="Add Video"
                    SemanticProperties.Hint="Record a new video or choose one from your library">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAddTapped" />
                </Border.GestureRecognizers>
                <Border.Behaviors>
                    <toolkit:TouchBehavior PressedScale="0.85"
                                           DefaultAnimationDuration="80" />
                </Border.Behaviors>
                <Image Style="{StaticResource ActionCardIconSmall}"
                       WidthRequest="34"
                       HeightRequest="34"
                       Source="addcircle" />
            </Border>

            <!-- Right slot: Save -->
            <Grid Grid.Column="2" HorizontalOptions="Start" VerticalOptions="Center" Margin="16,0,0,0">

                <Border Style="{StaticResource ActionCardTab}"
                        IsVisible="{Binding IsSessionProcessed}"
                        SemanticProperties.Description="Save"
                        SemanticProperties.Hint="Saves the full video to your library">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SaveVideoCommand}" />
                    </Border.GestureRecognizers>
                    <Border.Behaviors>
                        <toolkit:TouchBehavior PressedScale="0.85"
                                               DefaultAnimationDuration="80" />
                    </Border.Behaviors>
                    <Image Style="{StaticResource ActionCardIconSmall}" Source="download" />
                </Border>

            </Grid>

        </Grid>

        <!-- Processing Overlay -->
        <Grid Grid.RowSpan="2"
              BackgroundColor="Black"
              IsVisible="{Binding IsProcessing}">

            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="20">

                <skia:SKLottieView Source="Bar-Clip-Lottie.json"
                                   RepeatCount="-1"
                                   WidthRequest="300"
                                   HeightRequest="300"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />

                <Label Text="{Binding StatusText}"
                       HorizontalOptions="Center"
                       TextColor="White"
                       FontAttributes="Bold"
                       FontSize="16"
                       Margin="0,0,0,60" />

                <ProgressBar Progress="{Binding Progress}"
                             HeightRequest="20"
                             WidthRequest="250"
                             Margin="0,-80,0,0" />

                <Label Text="{Binding Progress, StringFormat='{0:P0}'}"
                       HorizontalOptions="Center"
                       TextColor="White"
                       FontAttributes="Bold"
                       Margin="0,-10,0,0" />

            </VerticalStackLayout>

        </Grid>

    </Grid>

</ContentPage>