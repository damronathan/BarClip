<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             xmlns:converters="clr-namespace:BarClip.Maui.Converters;assembly=BarClip.Maui"
             x:Class="BarClip.Maui.SessionPage"
             Title="Session">
    <ContentPage.ToolbarItems>
        <ToolbarItem
            Text="Delete"
            Command="{Binding DeleteSessionCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*, Auto">

        <CollectionView Grid.Row="0"
                        ItemsSource="{Binding LiftVideos}"
                        SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="5,5,5,0"
                            Padding="10"
                            StrokeShape="RoundRectangle 8"
                            Stroke="White"
                            BackgroundColor="Transparent">

                        <Grid ColumnDefinitions="200,*"
                              RowDefinitions="Auto">

                            <Image Grid.Column="0"
                                   Source="{Binding ThumbnailPath}"
                                   Aspect="AspectFit"
                                   HeightRequest="200"
                                   WidthRequest="200" />

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="10"
                                                 Padding="10,0"
                                                 VerticalOptions="Center">

                                <Button Text="Trim"
                                        IsVisible="{Binding IsProcessed, Converter={StaticResource InvertedBoolConverter}}"
                                        Command="{Binding ProcessCommand}"
                                        BackgroundColor="{DynamicResource Primary}"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        HeightRequest="30"
                                        CornerRadius="8"
                                        HorizontalOptions="Fill" />

                                <Button Text="Play"
                                        IsVisible="{Binding IsProcessed}"
                                        Command="{Binding ProcessCommand}"
                                        BackgroundColor="{DynamicResource Primary}"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        HeightRequest="30"
                                        CornerRadius="8"
                                        HorizontalOptions="Fill" />

                                <Button Text="Save"
                                        IsVisible="{Binding IsProcessed}"
                                        Command="{Binding SaveCommand}"
                                        BackgroundColor="{DynamicResource Primary}"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        HeightRequest="30"
                                        CornerRadius="8"
                                        HorizontalOptions="Fill" />

                            </VerticalStackLayout>

                        </Grid>

                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <VerticalStackLayout Spacing="10"
                                     Padding="10,10,10,20">

                    <Button Text="Create Full Video"
                            IsVisible="{Binding CanCreateFullVideo}"
                            Command="{Binding ProcessSessionCommand}"
                            BackgroundColor="{DynamicResource Primary}"
                            TextColor="White"
                            FontAttributes="Bold"
                            HeightRequest="55"
                            CornerRadius="12"
                            HorizontalOptions="Fill" />

                    <Button Text="Play Full Video"
                            IsVisible="{Binding IsSessionProcessed}"
                            Command="{Binding ProcessSessionCommand}"
                            BackgroundColor="{DynamicResource Primary}"
                            TextColor="White"
                            FontAttributes="Bold"
                            HeightRequest="55"
                            CornerRadius="12"
                            HorizontalOptions="Fill" />

                    <Button Text="Save Full Video"
                            IsVisible="{Binding IsSessionProcessed}"
                            Command="{Binding SaveVideoCommand}"
                            BackgroundColor="{DynamicResource Primary}"
                            TextColor="White"
                            FontAttributes="Bold"
                            HeightRequest="55"
                            CornerRadius="12"
                            HorizontalOptions="Fill" />

                    <Button Text="Upload Session"
                            IsVisible="{Binding HasVideos}"
                            Command="{Binding UploadSessionCommand}"
                            BackgroundColor="{DynamicResource Primary}"
                            TextColor="White"
                            FontAttributes="Bold"
                            HeightRequest="55"
                            CornerRadius="12"
                            HorizontalOptions="Fill" />

                </VerticalStackLayout>
            </CollectionView.Footer>

        </CollectionView>

        <!-- Bottom Tab Bar -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              BackgroundColor="Black"
              Padding="0,12,0,12">

            <VerticalStackLayout Grid.Column="1"
                     HorizontalOptions="Center"
                     Spacing="4">
                <Label Text="⏺"
           TextColor="White"
           FontSize="22"
           HorizontalOptions="Center" />
                <Label Text="Record"
           TextColor="White"
           FontSize="12"
           HorizontalOptions="Center" />
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CaptureVideoForSessionCommand}" />
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="0"
                                 HorizontalOptions="Center"
                                 Spacing="4">
                <Label Text="＋"
                       TextColor="White"
                       FontSize="22"
                       HorizontalOptions="Center" />
                <Label Text="Add Videos"
                       TextColor="White"
                       FontSize="12"
                       HorizontalOptions="Center" />
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding PickVideosForSessionCommand}" />
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>



        </Grid>

        <!-- Processing Overlay -->
        <Grid Grid.RowSpan="2"
              BackgroundColor="Black"
              IsVisible="{Binding IsProcessing}">

            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="20">

                <skia:SKLottieView Source="Bar-Clip-Lottie.json"
                                   RepeatCount="-1"
                                   WidthRequest="300"
                                   HeightRequest="300"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />

                <Label Text="{Binding StatusText}"
                       HorizontalOptions="Center"
                       TextColor="White"
                       FontAttributes="Bold"
                       FontSize="16"
                       Margin="0,0,0,60" />

                <ProgressBar Progress="{Binding Progress}"
                             HeightRequest="20"
                             WidthRequest="250"
                             Margin="0,-80,0,0" />

                <Label Text="{Binding Progress, StringFormat='{0:P0}'}"
                       HorizontalOptions="Center"
                       TextColor="White"
                       FontAttributes="Bold"
                       Margin="0,-10,0,0" />

            </VerticalStackLayout>

        </Grid>

    </Grid>

</ContentPage>