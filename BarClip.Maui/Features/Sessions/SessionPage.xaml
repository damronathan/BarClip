<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             xmlns:converters="clr-namespace:BarClip.Maui.Converters;assembly=BarClip.Maui"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="BarClip.Maui.SessionPage"
             Title="Session">
    <ContentPage.ToolbarItems>
        <ToolbarItem
            Text="Delete"
            Command="{Binding DeleteSessionCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*, Auto">

        <CollectionView Grid.Row="0"
                        ItemsSource="{Binding LiftVideos}"
                        SelectionMode="None">

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                  Span="2"
                                  VerticalItemSpacing="8"
                                  HorizontalItemSpacing="8" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid HeightRequest="170"
                          Margin="5">

                        <!-- Thumbnail -->
                        <Image Source="{Binding ThumbnailPath}"
                               Aspect="AspectFill" />

                        <!-- Play icon centered over the thumbnail (scrim + shadow) -->
                        <Border IsVisible="{Binding IsProcessed}"
        BackgroundColor="#80000000"
        Stroke="Transparent"
        StrokeThickness="0"
        StrokeShape="RoundRectangle 32"
        Padding="0"
        HeightRequest="64"
        WidthRequest="64"
        HorizontalOptions="Center"
        VerticalOptions="Center">
                            <Border.Shadow>
                                <Shadow Brush="Black" Opacity="0.6" Radius="8" Offset="0,2" />
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ProcessCommand}" />
                            </Border.GestureRecognizers>
                            <Border.Behaviors>
                                <toolkit:TouchBehavior PressedScale="0.85"
                               DefaultAnimationDuration="80" />
                            </Border.Behaviors>
                            <Image Style="{StaticResource ActionCardIconSmall}" Source="playcircle" />
                        </Border>

                        <!-- Trim: bottom-right corner, shown only before processing -->
                        <Border IsVisible="{Binding IsProcessed, Converter={StaticResource InvertedBoolConverter}}"
        BackgroundColor="#80000000"
        Stroke="Transparent"
        StrokeThickness="0"
        StrokeShape="RoundRectangle 20"
        Padding="0"
        HeightRequest="32"
        WidthRequest="32"
        HorizontalOptions="End"
        VerticalOptions="End"
        Margin="0,0,6,6">
                            <Border.Shadow>
                                <Shadow Brush="Black" Opacity="0.6" Radius="8" Offset="0,2" />
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ProcessCommand}" />
                            </Border.GestureRecognizers>
                            <Border.Behaviors>
                                <toolkit:TouchBehavior PressedScale="0.85"
                               DefaultAnimationDuration="80" />
                            </Border.Behaviors>
                            <Image Style="{StaticResource ActionCardIconSmall}"
           Source="trim"
           WidthRequest="16"
           HeightRequest="16" />
                        </Border>

                        <!-- Save: bottom-right corner, shown only after processing -->
                        <Border IsVisible="{Binding IsProcessed}"
        BackgroundColor="#80000000"
        Stroke="Transparent"
        StrokeThickness="0"
        StrokeShape="RoundRectangle 20"
        Padding="0"
        HeightRequest="32"
        WidthRequest="32"
        HorizontalOptions="End"
        VerticalOptions="End"
        Margin="0,0,6,6">
                            <Border.Shadow>
                                <Shadow Brush="Black" Opacity="0.6" Radius="8" Offset="0,2" />
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SaveCommand}" />
                            </Border.GestureRecognizers>
                            <Border.Behaviors>
                                <toolkit:TouchBehavior PressedScale="0.85"
                               DefaultAnimationDuration="80" />
                            </Border.Behaviors>
                            <Image Style="{StaticResource ActionCardIconSmall}"
           Source="download"
           WidthRequest="16"
           HeightRequest="16" />
                        </Border>

                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            
        </CollectionView>

        <!-- Bottom Tab Bar -->
        <Grid Grid.Row="1"
      ColumnDefinitions="*,Auto,*"
      BackgroundColor="#80000000"
      Padding="10,12,10,12"
      SafeAreaEdges="None">

            <!-- Left slot: Merge -> Play -->
            <Grid Grid.Column="0" HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,16,0">

                <Border Style="{StaticResource ActionCardTab}"
                        IsVisible="{Binding CanCreateFullVideo}"
                        SemanticProperties.Description="Create Full Video"
                        SemanticProperties.Hint="Merges the session's videos into one">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ProcessSessionCommand}" />
                    </Border.GestureRecognizers>
                    <Border.Behaviors>
                        <toolkit:TouchBehavior PressedScale="0.85"
                                               DefaultAnimationDuration="80" />
                    </Border.Behaviors>
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Image Style="{StaticResource ActionCardIconSmall}" Source="merge" />
                        <Label Text="Merge"
                               FontSize="9"
                               TextColor="White"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource ActionCardTab}"
                        IsVisible="{Binding IsSessionProcessed}"
                        SemanticProperties.Description="Play Full Video"
                        SemanticProperties.Hint="Plays the merged session video">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ProcessSessionCommand}" />
                    </Border.GestureRecognizers>
                    <Border.Behaviors>
                        <toolkit:TouchBehavior PressedScale="0.85"
                                               DefaultAnimationDuration="80" />
                    </Border.Behaviors>
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Image Style="{StaticResource ActionCardIconSmall}" Source="playcircle" />
                        <Label Text="Play"
                               FontSize="9"
                               TextColor="White"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

            </Grid>

            <!-- Center: Camera + Add -->
            <HorizontalStackLayout Grid.Column="1"
                        Spacing="16"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                <Border Style="{StaticResource ActionCardTab}"
            WidthRequest="56"
            HeightRequest="56"
            SemanticProperties.Description="Record Video"
            SemanticProperties.Hint="Opens the camera to record a new video">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CaptureVideoForSessionCommand}" />
                    </Border.GestureRecognizers>
                    <Border.Behaviors>
                        <toolkit:TouchBehavior PressedScale="0.85"
                                   DefaultAnimationDuration="80" />
                    </Border.Behaviors>
                    <Image Style="{StaticResource ActionCardIconSmall}"
               Source="camera"
               WidthRequest="26"
               HeightRequest="26" />
                </Border>

                <Border Style="{StaticResource ActionCardTab}"
            WidthRequest="85"
            HeightRequest="85"
            SemanticProperties.Description="Add Video"
            SemanticProperties.Hint="Choose a video from your library">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PickVideosForSessionCommand}" />
                    </Border.GestureRecognizers>
                    <Border.Behaviors>
                        <toolkit:TouchBehavior PressedScale="0.85"
                                   DefaultAnimationDuration="80" />
                    </Border.Behaviors>
                    <Image Style="{StaticResource ActionCardIconSmall}"
               WidthRequest="85"
               HeightRequest="85"
               Source="addcircle" />
                </Border>

            </HorizontalStackLayout>

            <!-- Right slot: Save -->
            <Grid Grid.Column="2" HorizontalOptions="Start" VerticalOptions="Center" Margin="16,0,0,0">

                <Border Style="{StaticResource ActionCardTab}"
                        IsVisible="{Binding IsSessionProcessed}"
                        SemanticProperties.Description="Save"
                        SemanticProperties.Hint="Saves the full video to your library">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SaveVideoCommand}" />
                    </Border.GestureRecognizers>
                    <Border.Behaviors>
                        <toolkit:TouchBehavior PressedScale="0.85"
                                               DefaultAnimationDuration="80" />
                    </Border.Behaviors>
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Image Style="{StaticResource ActionCardIconSmall}" Source="download" />
                        <Label Text="Save"
                               FontSize="9"
                               TextColor="White"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

            </Grid>

        </Grid>

        <!-- Processing Overlay -->
        <Grid Grid.RowSpan="2"
              BackgroundColor="Black"
              IsVisible="{Binding IsProcessing}">

            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="20">

                <skia:SKLottieView Source="Bar-Clip-Lottie.json"
                                   RepeatCount="-1"
                                   WidthRequest="300"
                                   HeightRequest="300"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />

                <Label Text="{Binding StatusText}"
                       HorizontalOptions="Center"
                       TextColor="White"
                       FontAttributes="Bold"
                       FontSize="16"
                       Margin="0,0,0,60" />

                <ProgressBar Progress="{Binding Progress}"
                             HeightRequest="20"
                             WidthRequest="250"
                             Margin="0,-80,0,0" />

                <Label Text="{Binding Progress, StringFormat='{0:P0}'}"
                       HorizontalOptions="Center"
                       TextColor="White"
                       FontAttributes="Bold"
                       Margin="0,-10,0,0" />

            </VerticalStackLayout>

        </Grid>

    </Grid>

</ContentPage>