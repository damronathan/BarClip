<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Class="BarClip.Maui.SessionPage"
             Title="Session">

    <Grid>

        <CollectionView ItemsSource="{Binding LiftVideos}"
                        SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="5,5,5,0"
                Padding="10"
                StrokeShape="RoundRectangle 8"
                Stroke="White"
                BackgroundColor="Transparent">

                        <Grid ColumnDefinitions="200,*" RowDefinitions="Auto">

                            <Image Grid.Column="0"
                       Source="{Binding ThumbnailPath}"
                       Aspect="AspectFit"
                       HeightRequest="200"
                       WidthRequest="200" />

                            <VerticalStackLayout Grid.Column="1"
                                     Spacing="10"
                                     Padding="10,0"
                                     VerticalOptions="Center">

                                <Button Text="Trim"
                            Command="{Binding ProcessCommand}"
                            BackgroundColor="{DynamicResource Primary}"
                            TextColor="White"
                            FontAttributes="Bold"
                            HeightRequest="30"
                            CornerRadius="8"
                            HorizontalOptions="Fill" />

                            </VerticalStackLayout>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <VerticalStackLayout Spacing="10" Padding="10,10,10,20">

                    <Button Text="Process Session"
                            Command="{Binding ProcessSessionCommand}"
                            BackgroundColor="{DynamicResource Primary}"
                            TextColor="White"
                            FontAttributes="Bold"
                            HeightRequest="55"
                            CornerRadius="12"
                            HorizontalOptions="Fill"/>

                    <Button Text="Upload Session"
                            Command="{Binding UploadSessionCommand}"
                            BackgroundColor="{DynamicResource Primary}"
                            TextColor="White"
                            FontAttributes="Bold"
                            HeightRequest="55"
                            CornerRadius="12"
                            HorizontalOptions="Fill"/>

                    <Button Text="Delete Session"
                            Command="{Binding DeleteSessionCommand}"
                            BackgroundColor="{DynamicResource Primary}"
                            TextColor="White"
                            FontAttributes="Bold"
                            HeightRequest="55"
                            CornerRadius="12"
                            HorizontalOptions="Fill"/>

                </VerticalStackLayout>
            </CollectionView.Footer>

        </CollectionView>

        <!-- Processing Overlay -->
        <Grid BackgroundColor="Black" IsVisible="{Binding IsProcessing}">
            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="20">

                <skia:SKLottieView
                    Source="Bar-Clip-Lottie.json"
                    RepeatCount="-1"
                    WidthRequest="300"
                    HeightRequest="300"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"/>

                <Label Text="{Binding StatusText}"
                       HorizontalOptions="Center"
                       TextColor="White"
                       FontAttributes="Bold"
                       FontSize="16"
                       Margin="0,0,0,60"/>

                <ProgressBar Progress="{Binding Progress}"
                             HeightRequest="20"
                             WidthRequest="250"
                             Margin="0,-80,0,0"/>

                <Label Text="{Binding Progress, StringFormat='{0:P0}'}"
                       HorizontalOptions="Center"
                       TextColor="White"
                       FontAttributes="Bold"
                       Margin="0,-10,0,0"/>

            </VerticalStackLayout>
        </Grid>

    </Grid>

</ContentPage>