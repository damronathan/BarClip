<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             xmlns:converters="clr-namespace:BarClip.Maui.Converters;assembly=BarClip.Maui"
             x:Class="BarClip.Maui.SessionPage"
             Title="Session">
    <ContentPage.ToolbarItems>
        <ToolbarItem
            Text="Delete"
            Command="{Binding DeleteSessionCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*, Auto">

        <CollectionView Grid.Row="0"
                        ItemsSource="{Binding LiftVideos}"
                        SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="5,5,5,0"
                            Padding="10"
                            StrokeShape="RoundRectangle 8"
                            Stroke="White"
                            BackgroundColor="Transparent">

                        <Grid ColumnDefinitions="200,*"
                              RowDefinitions="Auto">

                            <!-- Thumbnail -->
                            <Image Grid.Column="0"
                                   Source="{Binding ThumbnailPath}"
                                   Aspect="AspectFit"
                                   HeightRequest="200"
                                   WidthRequest="200" />

                            <!-- Play icon centered over the thumbnail (scrim + shadow) -->
                            <Border Grid.Column="0"
                                    IsVisible="{Binding IsProcessed}"
                                    BackgroundColor="#80000000"
                                    Stroke="Transparent"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 32"
                                    Padding="0"
                                    HeightRequest="64"
                                    WidthRequest="64"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Opacity="0.6" Radius="8" Offset="0,2" />
                                </Border.Shadow>
                                <ImageButton Source="playcircle"
                                             Command="{Binding ProcessCommand}"
                                             BackgroundColor="Transparent"
                                             Padding="0"
                                             Aspect="AspectFit"
                                             HeightRequest="40"
                                             WidthRequest="40"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center" />
                            </Border>

                            <!-- Trim: same slot as Save, shown only before processing -->
                            <Border Grid.Column="1"
                                    IsVisible="{Binding IsProcessed, Converter={StaticResource InvertedBoolConverter}}"
                                    BackgroundColor="#80000000"
                                    Stroke="Transparent"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 24"
                                    Padding="0"
                                    HeightRequest="48"
                                    WidthRequest="48"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Opacity="0.6" Radius="6" Offset="0,2" />
                                </Border.Shadow>
                                <ImageButton Source="trim"
                                             Command="{Binding ProcessCommand}"
                                             BackgroundColor="Transparent"
                                             Padding="0"
                                             Aspect="AspectFit"
                                             HeightRequest="28"
                                             WidthRequest="28"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center" />
                            </Border>

                            <!-- Save: same slot as Trim, shown only after processing -->
                            <Border Grid.Column="1"
                                    IsVisible="{Binding IsProcessed}"
                                    BackgroundColor="#80000000"
                                    Stroke="Transparent"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 24"
                                    Padding="0"
                                    HeightRequest="48"
                                    WidthRequest="48"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Opacity="0.6" Radius="6" Offset="0,2" />
                                </Border.Shadow>
                                <ImageButton Source="download"
                                             Command="{Binding SaveCommand}"
                                             BackgroundColor="Transparent"
                                             Padding="0"
                                             Aspect="AspectFit"
                                             HeightRequest="28"
                                             WidthRequest="28"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center" />
                            </Border>

                        </Grid>

                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <VerticalStackLayout Spacing="10"
                                     Padding="10,10,10,20">

                    <Button Text="Create Full Video"
                            IsVisible="{Binding CanCreateFullVideo}"
                            Command="{Binding ProcessSessionCommand}"
                            BackgroundColor="{DynamicResource Primary}"
                            TextColor="White"
                            FontAttributes="Bold"
                            HeightRequest="55"
                            CornerRadius="12"
                            HorizontalOptions="Fill" />

                    <Button Text="Play Full Video"
                            IsVisible="{Binding IsSessionProcessed}"
                            Command="{Binding ProcessSessionCommand}"
                            BackgroundColor="{DynamicResource Primary}"
                            TextColor="White"
                            FontAttributes="Bold"
                            HeightRequest="55"
                            CornerRadius="12"
                            HorizontalOptions="Fill" />

                    <Button Text="Save Full Video"
                            IsVisible="{Binding IsSessionProcessed}"
                            Command="{Binding SaveVideoCommand}"
                            BackgroundColor="{DynamicResource Primary}"
                            TextColor="White"
                            FontAttributes="Bold"
                            HeightRequest="55"
                            CornerRadius="12"
                            HorizontalOptions="Fill" />

                    <!--<Button Text="Upload Session"
                            IsVisible="{Binding HasVideos}"
                            Command="{Binding UploadSessionCommand}"
                            BackgroundColor="{DynamicResource Primary}"
                            TextColor="White"
                            FontAttributes="Bold"
                            HeightRequest="55"
                            CornerRadius="12"
                            HorizontalOptions="Fill" />-->

                </VerticalStackLayout>
            </CollectionView.Footer>

        </CollectionView>

        <!-- Bottom Tab Bar -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              ColumnSpacing="10"
              BackgroundColor="Black"
              Padding="10,12,10,12">

            <Button Grid.Column="0"
                    Text="Add Videos"
                    Command="{Binding PickVideosForSessionCommand}"
                    BackgroundColor="{DynamicResource Primary}"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    CornerRadius="12"
                    HorizontalOptions="Fill" />

            <Button Grid.Column="1"
                    Text="Record"
                    Command="{Binding CaptureVideoForSessionCommand}"
                    BackgroundColor="{DynamicResource Primary}"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    CornerRadius="12"
                    HorizontalOptions="Fill" />

        </Grid>

        <!-- Processing Overlay -->
        <Grid Grid.RowSpan="2"
              BackgroundColor="Black"
              IsVisible="{Binding IsProcessing}">

            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="20">

                <skia:SKLottieView Source="Bar-Clip-Lottie.json"
                                   RepeatCount="-1"
                                   WidthRequest="300"
                                   HeightRequest="300"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />

                <Label Text="{Binding StatusText}"
                       HorizontalOptions="Center"
                       TextColor="White"
                       FontAttributes="Bold"
                       FontSize="16"
                       Margin="0,0,0,60" />

                <ProgressBar Progress="{Binding Progress}"
                             HeightRequest="20"
                             WidthRequest="250"
                             Margin="0,-80,0,0" />

                <Label Text="{Binding Progress, StringFormat='{0:P0}'}"
                       HorizontalOptions="Center"
                       TextColor="White"
                       FontAttributes="Bold"
                       Margin="0,-10,0,0" />

            </VerticalStackLayout>

        </Grid>

    </Grid>

</ContentPage>