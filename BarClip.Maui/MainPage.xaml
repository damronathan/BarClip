<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Class="BarClip.Maui.MainPage">

    <ContentPage.ToolbarItems>
        <ToolbarItem
            x:Name="AuthToolbarItem"
            Text="Sign In"
            Clicked="OnAuthButtonClicked" />
    </ContentPage.ToolbarItems>

    <Grid>
        <ScrollView>
            <VerticalStackLayout
                Padding="30,0"
                Spacing="25"
                VerticalOptions="Center">
                <Label
                    Text="BarClip"
                    HeightRequest="100"
                    FontSize="70"
                    SemanticProperties.Description="Bar Clip Logo"
                    HorizontalOptions="Center"
                    FontAttributes="Bold" />
                <Button
                    x:Name="CreateBtn"
                    Text="{Binding CreateButtonText}"
                    SemanticProperties.Hint="Prompts user to select files for new session"
                    Clicked="CreateSession"
                    HorizontalOptions="Fill"
                    BorderColor="White"
                    FontAttributes="Bold"
                    FontSize="40" />
                <Button
                    x:Name="SessionBtn"
                    Text="Session Library"
                    SemanticProperties.Hint="Directs user to session library"
                    Clicked="NavigateToSessionLibraryPage"
                    HorizontalOptions="Fill"
                    BorderColor="White"
                    FontAttributes="Bold"
                    FontSize="40" />
                <Button
                    x:Name="VideoLibraryPageBtn"
                    Text="Video Library"
                    SemanticProperties.Hint="Directs user to video library"
                    Clicked="NavigateToVideoLibraryPage"
                    HorizontalOptions="Fill"
                    BorderColor="White"
                    FontAttributes="Bold"
                    FontSize="40" />
                <Button
                    x:Name="CameraBtn"
                    Text="Camera View"
                    SemanticProperties.Hint="Directs user to camera view"
                    Clicked="NavigateToCameraPage"
                    HorizontalOptions="Fill"
                    BorderColor="White"
                    FontAttributes="Bold"
                    FontSize="40" />
                <Button
                    x:Name="TestApiBtn"
                    Text="Test API"
                    Clicked="OnTestApiClicked"
                    HorizontalOptions="Fill"
                    BorderColor="White"
                    FontAttributes="Bold"
                    FontSize="40" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Overlay while processing -->
        <Grid BackgroundColor="Black" IsVisible="{Binding IsProcessing}">
            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="20">
                <skia:SKLottieView
                    Source="Bar-Clip-Lottie.json"
                    RepeatCount="-1"
                    WidthRequest="300"
                    HeightRequest="300"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"/>
                <Label
                    Text="{Binding StatusText}"
                    HorizontalOptions="Center"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="16"/>
                <ProgressBar
                    Progress="{Binding Progress}"
                    HeightRequest="20"
                    WidthRequest="250"
                    Margin="0,-80,0,0"/>
                <Label
                    Text="{Binding Progress, StringFormat='{0:P0}'}"
                    HorizontalOptions="Center"
                    TextColor="White"
                    FontAttributes="Bold"
                    Margin="0,-10,0,0"/>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>