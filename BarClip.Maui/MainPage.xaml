<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             Shell.NavBarIsVisible="False"
             x:Class="BarClip.Maui.MainPage">

    <Grid RowDefinitions="Auto,*">

        <!-- Top-left label -->
        <Label Grid.Row="0"
               Text="BarClip"
               FontSize="21"
               FontAttributes="Bold"
               Margin="20,16,0,0"
               HorizontalOptions="Start"
               VerticalOptions="Start" />

        <!-- Two action cards, centered as a group -->
        <Grid Grid.Row="1"
              RowDefinitions="Auto,Auto"
              RowSpacing="20"
              HorizontalOptions="Center"
              VerticalOptions="Center">

            <Border Grid.Row="0"
                    x:Name="CreateBtn"
                    Style="{StaticResource ActionCardPrimary}"
                    SemanticProperties.Description="Create Session"
                    SemanticProperties.Hint="Prompts user to select files for new session">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="CreateSession" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="10" VerticalOptions="Center">
                    <Image Style="{StaticResource ActionCardIcon}" Source="addcircle" />
                    <Label Style="{StaticResource ActionCardLabel}" Text="{Binding CreateButtonText}" />
                </VerticalStackLayout>
            </Border>

            <Border Grid.Row="1"
                    x:Name="SessionCard"
                    Style="{StaticResource ActionCardSecondary}"
                    SemanticProperties.Description="Sessions"
                    SemanticProperties.Hint="Directs user to session library">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="NavigateToSessionLibraryPage" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="10" VerticalOptions="Center">
                    <Image Style="{StaticResource ActionCardIcon}" Source="listcircle" />
                    <Label Style="{StaticResource ActionCardLabel}" Text="Sessions" />
                </VerticalStackLayout>
            </Border>

        </Grid>

        <!-- Overlay while processing -->
        <Grid Grid.RowSpan="2" BackgroundColor="{StaticResource OverlayScrim}" IsVisible="{Binding IsProcessing}">
            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="20">
                <skia:SKLottieView
                    Source="Bar-Clip-Lottie.json"
                    RepeatCount="-1"
                    WidthRequest="300"
                    HeightRequest="300"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"/>
                <Label
                    Text="{Binding StatusText}"
                    HorizontalOptions="Center"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="16"
                    Margin="0,0,0,60"/>

            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>





