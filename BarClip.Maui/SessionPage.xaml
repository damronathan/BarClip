<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:BarClip.Maui.Converters"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Class="BarClip.Maui.SessionPage"
             Title="Session">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:LifterFilterToBoolConverter x:Key="LifterFilterToBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>

        <!-- Main Content -->
        <ScrollView>
            <VerticalStackLayout Spacing="20" Padding="10">

                <!-- Lift Videos List -->
                <VerticalStackLayout 
                    Spacing="20"
                    BindableLayout.ItemsSource="{Binding LiftVideos}">

                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Frame Margin="5"
                                   Padding="10"
                                   CornerRadius="8"
                                   HasShadow="True"
                                   BorderColor="White"
                                   BackgroundColor="Transparent">

                                <Grid ColumnDefinitions="400,*" RowDefinitions="Auto">

                                    <!-- Thumbnail -->
                                    <Image Grid.Column="0"
                                           Source="{Binding ThumbnailPath}"
                                           Aspect="AspectFit"
                                           HeightRequest="400"
                                           WidthRequest="400" />

                                    <!-- Form -->
                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="10"
                                                         Padding="10,0"
                                                         VerticalOptions="Center">

                                        <!-- Weight entry -->
                                        <Label Text="Weight (kg):" 
                                               FontAttributes="Bold"
                                               FontSize="20"
                                               Margin="0,5,0,0" />

                                        <Entry Placeholder="Weight (kg)"
                                               Keyboard="Numeric"
                                               Text="{Binding Lift.WeightKg, Mode=TwoWay}" />

                                        <!-- Lifter filter radio buttons -->
                                        <Label Text="Lifter Filter:" 
                                               FontAttributes="Bold" 
                                               Margin="0,5,0,0" />

                                        <HorizontalStackLayout Spacing="15">
                                            <RadioButton Content="Whole" 
                                                         IsChecked="{Binding IsWhole}" 
                                                         GroupName="{Binding Video.Id}" />
                                            <RadioButton Content="Left" 
                                                         IsChecked="{Binding IsLeft}" 
                                                         GroupName="{Binding Video.Id}" />
                                            <RadioButton Content="Right" 
                                                         IsChecked="{Binding IsRight}" 
                                                         GroupName="{Binding Video.Id}" />
                                        </HorizontalStackLayout>

                                    </VerticalStackLayout>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Submit buttons -->
                <Button Text="Save Session"
                        Command="{Binding SubmitSessionCommand}"
                        BackgroundColor="{DynamicResource Primary}"
                        TextColor="White"
                        FontAttributes="Bold"
                        HeightRequest="55"
                        CornerRadius="12"
                        HorizontalOptions="Fill"
                        Margin="0,10,0,20"/>

                <Button Text="Process Session"
                        Command="{Binding ProcessSessionCommand}"
                        BackgroundColor="{DynamicResource Primary}"
                        TextColor="White"
                        FontAttributes="Bold"
                        HeightRequest="55"
                        CornerRadius="12"
                        HorizontalOptions="Fill"
                        Margin="0,10,0,20"/>
                <Button Text="Upload Session"
                        Command="{Binding UploadSessionCommand}"
                        BackgroundColor="{DynamicResource Primary}"
                        TextColor="White"
                        FontAttributes="Bold"
                        HeightRequest="55"
                        CornerRadius="12"
                        HorizontalOptions="Fill"
                        Margin="0,10,0,20"/>
                <Button Text="Delete Session"
                        Command="{Binding DeleteSessionCommand}"
                        BackgroundColor="{DynamicResource Primary}"
                        TextColor="White"
                        FontAttributes="Bold"
                        HeightRequest="55"
                        CornerRadius="12"
                        HorizontalOptions="Fill"
                        Margin="0,10,0,20"/>


            </VerticalStackLayout>
        </ScrollView>

        <!-- Overlay while processing -->
        <Grid BackgroundColor="Black" IsVisible="{Binding IsProcessing}">
            <VerticalStackLayout VerticalOptions="Center" 
                                 HorizontalOptions="Center" 
                                 Spacing="20">

                <!-- Lottie Animation -->
                <skia:SKLottieView 
                    Source="Bar-Clip-Lottie.json"
                    RepeatCount="-1"
                    WidthRequest="300"
                    HeightRequest="300"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"/>

                <!-- Progress Bar -->
                <ProgressBar 
                    Progress="{Binding Progress}" 
                    HeightRequest="20" 
                    WidthRequest="250"
                    Margin="0,-80,0,0"/>

                <Label 
                    Text="{Binding Progress, StringFormat='{0:P0}'}" 
                    HorizontalOptions="Center" 
                    TextColor="White" 
                    FontAttributes="Bold"
                    Margin="0,-10,0,0"/>

            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>